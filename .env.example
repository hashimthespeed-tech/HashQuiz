# Copy to .env and use your own values. Never commit .env.
DATABASE_URL=postgresql://user:password@localhost:5432/hosh_quiz
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=3000
NODE_ENV=development
# Set only to provision the initial admin; remove the password after provisioning.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=
