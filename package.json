{
  "name": "hosh-quiz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:admin": "node --env-file-if-exists=.env scripts/admin.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:local": "node scripts/local-db.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:local": "node scripts/test-local.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "playwright-core": "^1.64.1",
    "supertest": "^7.3.1"
  }
}
